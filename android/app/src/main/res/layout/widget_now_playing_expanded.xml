<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_nordic_card_bg"
    android:padding="0dp">

    <!-- Bottom Mountain Waves Graphic Backdrop -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_alignParentBottom="true"
        android:scaleType="fitXY"
        android:src="@drawable/widget_mountain_waves"
        android:contentDescription="Mountain Waves" />

    <!-- Main Content Container with Padding -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Top-Left Album Artwork -->
        <ImageView
            android:id="@+id/widget_art_image"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_art_rounded_bg"
            android:src="@drawable/ic_widget_album_placeholder"
            android:contentDescription="Album Art" />

        <!-- Top-Right Actions: Heart & 3-Dots -->
        <LinearLayout
            android:id="@+id/widget_actions_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_favorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_heart"
                android:scaleType="centerInside"
                android:contentDescription="Favorite" />

            <ImageButton
                android:id="@+id/widget_btn_overflow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_dots"
                android:scaleType="centerInside"
                android:contentDescription="Options" />
        </LinearLayout>

        <!-- Track Title & Artist -->
        <LinearLayout
            android:id="@+id/widget_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_art_image"
            android:layout_toStartOf="@id/widget_actions_row"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Night We Met"
                android:textColor="@color/nordic_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Lord Huron"
                android:textColor="@color/nordic_text_secondary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Middle: Progress Bar Section -->
        <RelativeLayout
            android:id="@+id/widget_progress_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_art_image"
            android:layout_marginTop="12dp">

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_alignParentTop="true"
                android:max="100"
                android:progress="42"
                android:progressDrawable="@drawable/widget_progress_track" />

            <TextView
                android:id="@+id/widget_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/widget_progress_bar"
                android:layout_alignParentStart="true"
                android:layout_marginTop="3dp"
                android:text="2:14"
                android:textColor="@color/nordic_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/widget_progress_bar"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="3dp"
                android:text="3:28"
                android:textColor="@color/nordic_text_secondary"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- Bottom Controls Row: Shuffle, Prev, Play/Pause, Next, Repeat -->
        <LinearLayout
            android:id="@+id/widget_controls_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_shuffle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_shuffle"
                android:scaleType="centerInside"
                android:contentDescription="Shuffle" />

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="14dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_prev"
                android:scaleType="centerInside"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/widget_play_btn_cobalt"
                android:elevation="4dp"
                android:src="@drawable/ic_widget_pause"
                android:scaleType="centerInside"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="14dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_next"
                android:scaleType="centerInside"
                android:contentDescription="Next" />

            <ImageButton
                android:id="@+id/widget_btn_repeat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_repeat"
                android:scaleType="centerInside"
                android:contentDescription="Repeat" />
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>

