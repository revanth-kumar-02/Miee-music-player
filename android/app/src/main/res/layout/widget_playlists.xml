<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_nordic_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Layers Icon + Title + Chevron Arrow -->
    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_header_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_widget_playlists"
            android:contentDescription="Playlists" />

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_header_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="Playlists"
            android:textColor="@color/nordic_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_header_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_widget_chevron"
            android:contentDescription="Open Playlists" />
    </RelativeLayout>

    <!-- 4 Cards Row: 3 Playlists + 1 New Playlist -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Playlist 1 -->
        <LinearLayout
            android:id="@+id/widget_playlist1_root"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_playlist1_art"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_art_rounded_bg"
                android:src="@drawable/ic_widget_album_placeholder"
                android:contentDescription="Playlist 1" />

            <TextView
                android:id="@+id/widget_playlist1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Chill"
                android:textColor="@color/nordic_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_playlist1_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42 songs"
                android:textColor="@color/nordic_text_secondary"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Playlist 2 -->
        <LinearLayout
            android:id="@+id/widget_playlist2_root"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_playlist2_art"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_art_rounded_bg"
                android:src="@drawable/ic_widget_album_placeholder"
                android:contentDescription="Playlist 2" />

            <TextView
                android:id="@+id/widget_playlist2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Focus"
                android:textColor="@color/nordic_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_playlist2_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28 songs"
                android:textColor="@color/nordic_text_secondary"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Playlist 3 -->
        <LinearLayout
            android:id="@+id/widget_playlist3_root"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_playlist3_art"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_art_rounded_bg"
                android:src="@drawable/ic_widget_album_placeholder"
                android:contentDescription="Playlist 3" />

            <TextView
                android:id="@+id/widget_playlist3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Workout"
                android:textColor="@color/nordic_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_playlist3_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="36 songs"
                android:textColor="@color/nordic_text_secondary"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Card 4: New Playlist -->
        <LinearLayout
            android:id="@+id/widget_playlist_new_root"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_new_playlist_card_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_widget_plus"
                android:contentDescription="Add Playlist" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="New Playlist"
                android:textColor="@color/nordic_cobalt_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

