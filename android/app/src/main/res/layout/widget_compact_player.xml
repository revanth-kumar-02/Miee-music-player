<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_notification"
        android:contentDescription="@string/app_name"
        android:padding="4dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Miee Music"
            android:textColor="#FFFDF9"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to play"
            android:textColor="#C4A8B0"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_btn_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FFFDF9"
        android:contentDescription="Previous" />

    <ImageButton
        android:id="@+id/widget_btn_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_play_bg"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FFFDF9"
        android:contentDescription="Play/Pause" />

    <ImageButton
        android:id="@+id/widget_btn_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FFFDF9"
        android:contentDescription="Next" />

</LinearLayout>

